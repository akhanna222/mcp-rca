# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Configuration File Path (optional)
# If not set, will look for config/platform.yaml or platform.yaml
# RCA_CONFIG_PATH=/path/to/your/config.yaml

# Google Cloud Authentication (optional)
# If using service account authentication instead of Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Logging Configuration (optional, overrides config file)
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Server Configuration (optional, overrides config file)
# ALERT_HOST=0.0.0.0
# ALERT_PORT=5000
# METRICS_PORT=9090
